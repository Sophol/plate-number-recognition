FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

WORKDIR /app

# Pinned to 3.12: torch/paddleocr/onnxruntime wheel support lags newer releases.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3-pip pkg-config \
    libgl1 libglib2.0-0 libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements/gpu.txt requirements/
RUN pip3 install --no-cache-dir -r requirements/gpu.txt

COPY . .

CMD ["python3", "-m", "apps.inference_worker.main"]
